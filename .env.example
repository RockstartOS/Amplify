# Attendee session signing (set a long random value in production)
SESSION_SECRET=change-me

# Organiser backend password
ADMIN_PASSWORD=amplify

# Social login (OpenID Connect). Leave blank to disable in production;
# in development the buttons fall back to a labelled demo identity.
# Redirect URI to register with each provider:
#   {BASE_URL}/api/auth/google/callback
#   {BASE_URL}/api/auth/linkedin/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional: force the OAuth redirect base (otherwise derived from the request)
# OAUTH_BASE_URL=https://your-domain.example
